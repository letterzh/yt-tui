Screen {
    background: #101820;
    color: #e8eef2;
}

Header {
    background: #17324d;
    color: #ffffff;
}

#main {
    height: 1fr;
    padding: 1 2;
}

TabbedContent {
    height: 1fr;
    border: round #42627d;
}

TabPane {
    padding: 1;
}

.toolbar {
    height: 3;
    margin-bottom: 1;
    align-vertical: middle;
}

.toolbar Input {
    width: 1fr;
    margin-right: 1;
}

.toolbar Button {
    margin-right: 1;
}

DataTable {
    height: 1fr;
}

#recommendation-status,
#subscription-status,
#search-status,
#download-status {
    width: 1fr;
    height: 3;
    padding: 1;
    color: #b8c9d6;
}

#activity-bar {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
    border-top: solid #42627d;
}

#activity-label {
    width: 1fr;
    color: #b8c9d6;
}

#activity-progress {
    width: 2fr;
}

Footer {
    background: #17324d;
}
